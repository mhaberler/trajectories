# Copy to /etc/default/trajectories-api.env (optional overrides).
# TRAJECTORIES_OM_ROOT=/open-meteo
# TRAJECTORIES_BACKEND=auto
# TRAJECTORIES_API_BASE=https://open-meteo.mah.priv.at
# ICON Global HTTP host (default: https://open-meteo-temp.mah.priv.at)
# TRAJECTORIES_ICON_GLOBAL_API_BASE=https://open-meteo-temp.mah.priv.at
#
# DEM backend for POST /v1/elevation/* : joerd (default) | mapterhorn | glo30
# TRAJECTORIES_DEM_BACKEND=joerd
# TRAJECTORIES_DEM_DEBUG=1
#
# Joerd (AWS Terrain Tiles / Terrarium PNG, fixed zoom)
# TRAJECTORIES_JOERD_BASE=https://s3.amazonaws.com/elevation-tiles-prod
# TRAJECTORIES_JOERD_ZOOM=12
# TRAJECTORIES_JOERD_CACHE=/var/cache/trajectories/joerd
# TRAJECTORIES_JOERD_CACHE_MAX_BYTES=5368709120
# TRAJECTORIES_JOERD_DEBUG=1
#
# Mapterhorn DEM tile cache (when TRAJECTORIES_DEM_BACKEND=mapterhorn)
# TRAJECTORIES_MAPTERHORN_CACHE=/var/cache/trajectories/mapterhorn
# TRAJECTORIES_MAPTERHORN_CACHE_MAX_BYTES=5368709120
# TRAJECTORIES_MAPTERHORN_BASE=https://download.mapterhorn.com
# TRAJECTORIES_MAPTERHORN_DEBUG=1
#
# Copernicus GLO-30 Public COG (when TRAJECTORIES_DEM_BACKEND=glo30)
# Requires rasterio + system GDAL. On-demand 1° COG cache; no preseed required.
# TRAJECTORIES_GLO30_BASE=https://copernicus-dem-30m.s3.amazonaws.com
# TRAJECTORIES_GLO30_CACHE=/var/cache/trajectories/glo30
# TRAJECTORIES_GLO30_CACHE_MAX_BYTES=5368709120
# TRAJECTORIES_GLO30_DEBUG=1
